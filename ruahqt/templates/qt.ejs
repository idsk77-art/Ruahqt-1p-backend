<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="description" content="RuahQT 루아큐티 · <%= qt.date %> · <%= qt.title.replace(/\n/g, ' ') %>" />
  <title>RuahQT · <%= qt.date %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Noto+Sans+KR:wght@300;400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #F2F2F7;
      font-family: 'Nanum Myeongjo', 'Apple Myungjo', 'Batang', Georgia, serif;
      color: #18181B;
      min-height: 100vh;
    }

    .page {
      max-width: 430px;
      margin: 0 auto;
    }

    /* ── Highlight Styles ── */
    .hl-yellow { background: rgba(250,204,21,0.28); border-bottom: 2px solid rgba(234,179,8,0.65); padding: 0 3px; border-radius: 2px; }
    .hl-amber  { background: rgba(251,146,60,0.2);  border-bottom: 2px solid rgba(234,88,12,0.5);  padding: 0 3px; border-radius: 2px; }
    .hl-coral  { border-bottom: 2.5px solid #F87171; padding-bottom: 1px; }
    .hl-green  { background: rgba(52,211,153,0.18); border-bottom: 2px solid rgba(16,185,129,0.55); padding: 0 3px; border-radius: 2px; }
    .hl-blue   { border-bottom: 2.5px solid #93C5FD; padding-bottom: 1px; }
    .hl-pink   { background: rgba(251,113,133,0.15); border-bottom: 2px dashed rgba(244,63,94,0.5); padding: 0 3px; border-radius: 2px; }

    /* ── Header ── */
    .header {
      background: #18181B;
      padding: 36px 24px 28px;
      position: relative;
    }
    .header-brand {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 22px;
    }
    .header-brand-main {
      font-family: 'DM Serif Display', serif;
      font-size: 28px;
      font-weight: 400;
      color: #FFFFFF;
      letter-spacing: -0.5px;
    }
    .header-brand-sub {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 13px;
      color: #71717A;
      letter-spacing: 1px;
    }
    .header-divider {
      width: 32px;
      height: 1px;
      background: #52525B;
      margin-bottom: 20px;
    }
    .header-date {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 11px;
      color: #71717A;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }
    .header-title {
      font-size: 24px;
      font-weight: 800;
      color: #FFFFFF;
      line-height: 1.5;
      margin-bottom: 14px;
      white-space: pre-line;
    }
    .header-ref {
      display: inline-block;
      border: 1px solid #3F3F46;
      border-radius: 20px;
      padding: 5px 16px;
    }
    .header-ref span {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 12px;
      color: #A1A1AA;
      letter-spacing: 0.5px;
    }
    .corner { position: absolute; width: 28px; height: 28px; }
    .corner-tr { top: 20px; right: 22px; border-top: 1.5px solid #3F3F46; border-right: 1.5px solid #3F3F46; }
    .corner-br { bottom: 20px; right: 22px; border-bottom: 1.5px solid #3F3F46; border-right: 1.5px solid #3F3F46; }
    .header-accent { height: 3px; background: #3F3F46; }

    /* ── Content ── */
    .content { padding: 16px 14px 40px; }

    /* ── Section Card ── */
    .section {
      margin: 0 0 10px;
      background: #FFFFFF;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #E4E4E7;
    }
    .section-header {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 13px 18px;
      border-bottom: 1px solid #E4E4E7;
      background: #FAFAFA;
    }
    .section-header-dark {
      background: #18181B;
      border-bottom: 1px solid #3F3F46;
    }
    .section-icon { font-size: 15px; }
    .section-label {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      color: #71717A;
      text-transform: uppercase;
    }
    .section-body { padding: 18px 18px 20px; }

    /* ── Verse Number Badge ── */
    .vnum {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 20px;
      height: 20px;
      background: #3F3F46;
      color: #FFF;
      border-radius: 5px;
      font-size: 11px;
      font-weight: 600;
      font-family: 'Noto Sans KR', sans-serif;
      margin-right: 10px;
      flex-shrink: 0;
      vertical-align: middle;
      margin-top: 4px;
    }

    /* ── Verse Row ── */
    .verse-row {
      display: flex;
      align-items: flex-start;
      margin-bottom: 18px;
    }
    .verse-row:last-child { margin-bottom: 0; }
    .verse-text { margin: 0; line-height: 2; font-size: 16px; flex: 1; }

    /* ── Body Paragraph ── */
    .body-p { margin: 0 0 16px; line-height: 2; font-size: 16px; color: #18181B; }
    .body-p:last-child { margin: 0; }

    /* ── Keyword Box ── */
    .keyword-box {
      background: #F9F9F9;
      border-radius: 10px;
      border: 1px solid #E4E4E7;
      padding: 16px;
      margin-bottom: 14px;
    }
    .keyword-box-label {
      margin: 0 0 6px;
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 10px;
      letter-spacing: 2px;
      color: #A1A1AA;
    }
    .keyword-row {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
      align-items: flex-start;
    }
    .keyword-row:last-child { margin-bottom: 0; }
    .keyword-badge {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 11px;
      color: #FAFAFA;
      background: #3F3F46;
      border-radius: 4px;
      padding: 2px 7px;
      white-space: nowrap;
      margin-top: 2px;
      flex-shrink: 0;
    }
    .keyword-badge-ref { opacity: 0.6; }
    .keyword-desc {
      margin: 0;
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 13px;
      line-height: 1.7;
      color: #52525B;
    }

    /* ── Decision Prompt ── */
    .decision-prompt {
      border-left: 3px solid #3F3F46;
      padding-left: 14px;
      margin-bottom: 18px;
    }
    .decision-prompt p {
      margin: 0;
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 13px;
      font-style: italic;
      color: #52525B;
      line-height: 1.8;
    }

    /* ── Prayer Section ── */
    .prayer-section {
      background: #18181B;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #E4E4E7;
      margin: 0 0 10px;
    }
    .prayer-cross {
      text-align: center;
      margin-bottom: 20px;
    }
    .prayer-cross-wrap {
      display: inline-block;
      position: relative;
      width: 20px;
      height: 24px;
    }
    .prayer-cross-v {
      position: absolute;
      top: 0; left: 50%;
      transform: translateX(-50%);
      width: 2px; height: 24px;
      background: #52525B;
      border-radius: 2px;
    }
    .prayer-cross-h {
      position: absolute;
      top: 8px; left: 0;
      width: 20px; height: 2px;
      background: #52525B;
      border-radius: 2px;
    }
    .prayer-greeting {
      margin: 0 0 18px;
      font-size: 16px;
      line-height: 2.1;
      color: #E4E4E7;
      text-align: center;
    }
    .prayer-p {
      margin: 0 0 18px;
      font-size: 15.5px;
      line-height: 2.1;
      color: #D4D4D8;
    }
    .prayer-p:last-of-type { margin-bottom: 24px; }
    .prayer-closing {
      text-align: center;
      border-top: 1px solid #3F3F46;
      padding-top: 18px;
    }
    .prayer-closing-text {
      margin: 0;
      font-size: 15px;
      color: #A1A1AA;
      font-style: italic;
      letter-spacing: 0.5px;
    }
    .prayer-amen {
      margin: 6px 0 0;
      font-size: 18px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: 2px;
    }

    /* ── Footer ── */
    .footer { margin-top: 28px; padding: 0 4px; }
    .footer-inner { border-top: 1px solid #E4E4E7; padding-top: 18px; }
    .footer-source {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 10px;
      color: #A1A1AA;
      line-height: 1.9;
      margin: 0;
    }
    .footer-source-label {
      display: block;
      font-weight: 600;
      color: #71717A;
      margin-bottom: 4px;
      letter-spacing: 1px;
    }
    .footer-brand {
      font-family: 'Noto Sans KR', sans-serif;
      font-size: 10px;
      color: #D1D1D6;
      margin: 12px 0 0;
      letter-spacing: 1px;
      text-align: right;
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ══ HEADER ══ -->
  <div class="header">
    <div class="header-brand">
      <span class="header-brand-main">RuahQT</span>
      <span class="header-brand-sub">루아큐티</span>
    </div>
    <div class="header-divider"></div>
    <div class="header-date"><%= qt.date %> · <%= qt.subtitle %></div>
    <div class="header-title"><%= qt.title %></div>
    <div class="header-ref">
      <span><%= qt.reference %></span>
    </div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-br"></div>
  </div>
  <div class="header-accent"></div>

  <!-- ══ CONTENT ══ -->
  <div class="content">

    <!-- 말씀 본문 -->
    <div class="section">
      <div class="section-header">
        <span class="section-icon">📖</span>
        <span class="section-label">말씀 본문</span>
      </div>
      <div class="section-body">
        <% qt.verses.forEach(function(v) { %>
        <div class="verse-row">
          <span class="vnum"><%= v.n %></span>
          <p class="verse-text"><%- processHL(v.text) %></p>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- 내용 관찰 -->
    <div class="section">
      <div class="section-header">
        <span class="section-icon">🔍</span>
        <span class="section-label">내용 관찰</span>
      </div>
      <div class="section-body">
        <% qt.observation.forEach(function(p) { %>
        <p class="body-p"><%- processHL(p) %></p>
        <% }); %>
      </div>
    </div>

    <!-- 길잡이 -->
    <div class="section">
      <div class="section-header">
        <span class="section-icon">🧭</span>
        <span class="section-label">길잡이</span>
      </div>
      <div class="section-body">
        <!-- Keywords -->
        <div class="keyword-box">
          <p class="keyword-box-label">KEY WORDS</p>
          <% qt.keywords.forEach(function(k) { %>
          <div class="keyword-row">
            <span class="keyword-badge">
              <%= k.word %> <span class="keyword-badge-ref"><%= k.ref %></span>
            </span>
            <p class="keyword-desc"><%= k.desc %></p>
          </div>
          <% }); %>
        </div>
        <% qt.guide.forEach(function(p) { %>
        <p class="body-p"><%- processHL(p) %></p>
        <% }); %>
      </div>
    </div>

    <!-- 연구와 묵상 -->
    <div class="section">
      <div class="section-header">
        <span class="section-icon">📝</span>
        <span class="section-label">연구와 묵상</span>
      </div>
      <div class="section-body">
        <% qt.meditation.forEach(function(p) { %>
        <p class="body-p"><%- processHL(p) %></p>
        <% }); %>
      </div>
    </div>

    <!-- 결단과 적용 -->
    <div class="section">
      <div class="section-header">
        <span class="section-icon">✍️</span>
        <span class="section-label">결단과 적용</span>
      </div>
      <div class="section-body">
        <div class="decision-prompt">
          <p>"<%= qt.decision_prompt %>"</p>
        </div>
        <% qt.decision.forEach(function(p) { %>
        <p class="body-p"><%- processHL(p) %></p>
        <% }); %>
      </div>
    </div>

    <!-- 오늘의 기도 -->
    <div class="prayer-section">
      <div class="section-header section-header-dark">
        <span class="section-icon">🙏</span>
        <span class="section-label">오늘의 기도</span>
      </div>
      <div class="section-body">
        <div class="prayer-cross">
          <div class="prayer-cross-wrap">
            <div class="prayer-cross-v"></div>
            <div class="prayer-cross-h"></div>
          </div>
        </div>
        <p class="prayer-greeting">거룩하신 하나님 아버지,</p>
        <% qt.prayer.forEach(function(p) { %>
        <p class="prayer-p"><%- processHL(p) %></p>
        <% }); %>
        <div class="prayer-closing">
          <p class="prayer-closing-text">예수님의 이름으로 기도합니다.</p>
          <p class="prayer-amen">아 멘</p>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-inner">
        <p class="footer-source">
          <span class="footer-source-label">본문 출처</span>
          <%= qt.source_name %> · <%= qt.source_url %><br />
          <%= qt.book %> <%= qt.chapter %>:<%= qt.verse_start %>–<%= qt.verse_end %> · <%= qt.bible_version %><br />
          <%= qt.bible_copyright %>
        </p>
        <p class="footer-brand">RuahQT 루아큐티</p>
      </div>
    </div>

  </div><!-- /content -->
</div><!-- /page -->
</body>
</html>
